# Puerto del servidor Express
PORT=3001

# --- AWS Bedrock (requeridas) ---
# Región donde están habilitados los modelos
BEDROCK_REGION=sa-east-1

# Inference profile de Haiku para el Agente Analizador
BEDROCK_MODEL_ANALYZER=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Inference profile de Sonnet para el Agente Redactor EARS
BEDROCK_MODEL_EARS=global.anthropic.claude-sonnet-4-6

# --- Retry (opcionales, con defaults) ---
MAX_LLM_RETRIES=3
BASE_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# --- Concurrencia (opcional, default 4) ---
# Llamadas simultáneas a Bedrock. Un valor inválido cae al default.
MAX_LLM_CONCURRENCY=4
